# ══════════════════════════════════════════════════════════════
#  企业智能知识中枢 · 环境变量模板
#  用法：cp .env.example .env  然后按需修改
#  注意：所有配置集中在这个文件，代码里不写死任何地址与密码
#        正式部署时务必更换下列全部密钥
# ══════════════════════════════════════════════════════════════

# ── 数据库（PostgreSQL + pgvector）──────────────────────────
DATABASE_URL=postgres://khub:khub_dev_pwd@127.0.0.1:5432/knowledge_hub

# ── 缓存与队列（Redis）─────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── 对象存储（S3 协议）────────────────────────────────────
# 换移动云 EOS 时只改这一段：端点、密钥、桶名
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=khub_minio
S3_SECRET_KEY=khub_minio_dev_pwd
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ORIGINALS=originals
S3_BUCKET_DERIVED=derived
S3_BUCKET_SKILLS=skills
S3_BUCKET_EXPORTS=exports

# ── 应用服务 ───────────────────────────────────────────────
API_PORT=3101
WEB_PORT=3100
NODE_ENV=development

# 会话签名密钥（务必改成足够长的随机串：openssl rand -hex 32）
SESSION_SECRET=dev_only_change_me_openssl_rand_hex_32
SESSION_TTL_HOURS=12

# 允许的前端来源（跨域用，多个用逗号分隔）
CORS_ORIGINS=http://127.0.0.1:3100,http://localhost:3100

# ── 模型网关 ───────────────────────────────────────────────
# 聚智智能体平台 OpenAPI（HMAC-SHA256 签名）
# 以下四项需在平台「API 管理 → 应用详情」获取，请勿把真实值提交到仓库
JIUTIAN_HOST=<聚智平台地址:端口，如 10.0.0.1:30000>
JIUTIAN_APP_ID=<你的 AppID>
JIUTIAN_APP_SECRET=<你的 AppSecret>
JIUTIAN_MODEL_ID=<你的模型部署 ID>
JIUTIAN_MODEL_SOURCE=public

# ── 远程智能体 / 知识库同步 ────────────────────────────────
# 与上面的 JIUTIAN_* 是同一个聚智应用，填相同的值即可。
# 不填也不影响本地问答，只是智能体无法切到「远程」模式。
PLATFORM_HOST=<同 JIUTIAN_HOST>
PLATFORM_APP_ID=<同 JIUTIAN_APP_ID>
PLATFORM_APP_SECRET=<同 JIUTIAN_APP_SECRET>

# 可用模型部署 ID（逗号分隔；前一个叫法仅供界面展示，格式：显示名:部署ID）
MODEL_REGISTRY=九天 75B:jiutian_75b_sort20251225112916,九天蓝 35B:jiutian-lan-35b_sort20260630093127,DeepSeek-v4-flash:deepseek-v4-flash_sort20260630122526

# 向量模型（用于知识库切片向量化）
JIUTIAN_EMBED_MODEL=emb_v1_1024_sort20251223150304

# 模型调用超时与重试
MODEL_TIMEOUT_MS=60000
MODEL_MAX_RETRIES=2
MODEL_CIRCUIT_FAILS=3

# ── 文件上传限制 ───────────────────────────────────────────
MAX_UPLOAD_MB=200
CHUNK_SIZE_MB=5

# ── 邮件（阶段四用，先留空）────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── 日志 ───────────────────────────────────────────────────
LOG_LEVEL=info

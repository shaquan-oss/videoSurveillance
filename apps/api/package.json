{
  "name": "@kh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=../../.env tsx watch src/main.ts",
    "start": "DOTENV_CONFIG_PATH=../../.env tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.mjs --packages=external",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kh/server-core": "workspace:*",
    "@kh/shared": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "bullmq": "6.3.4",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "mammoth": "^1.12.2",
    "multer": "2.3.0",
    "nodemailer": "^10.0.8",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "xlsx": "^0.18.5",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "22.19.19",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
